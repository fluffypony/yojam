<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>title</key><string>All URLs</string>
		<key>predicate</key><string>TRUEPREDICATE</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Exact URL</string>
		<key>predicate</key><string>URL == "https://example.com/Exact"</string>
		<key>enabled</key><false/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Google Chrome.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Not exact URL</string>
		<key>predicate</key><string>URL != "https://example.com/private"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Contains case sensitive</string>
		<key>predicate</key><string>URL CONTAINS "CasePath"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Begins with</string>
		<key>predicate</key><string>URL BEGINSWITH "https://start.example/"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Ends with</string>
		<key>predicate</key><string>URL ENDSWITH "/finish"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Like whole URL</string>
		<key>predicate</key><string>URL LIKE "https://*.example.com/?*"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Matches case sensitive</string>
		<key>predicate</key><string>URL MATCHES "^https://example\\.com/Case[0-9]+$"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Source and URL</string>
		<key>predicate</key><string>sourceApp == "/Applications/Slack.app" AND URL CONTAINS[c] "GITHUB.COM"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Google Chrome.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
	<dict>
		<key>title</key><string>Split OR</string>
		<key>predicate</key><string>URL CONTAINS "one.example" OR URL CONTAINS "two.example"</string>
		<key>enabled</key><true/>
		<key>behaviour</key><integer>6</integer>
		<key>behaviourArgument</key>
		<dict><key>path</key><string>/Applications/Safari.app</string><key>type</key><string>ChoosyBrowser</string></dict>
	</dict>
</array>
</plist>
